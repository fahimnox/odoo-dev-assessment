<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trial_balance_wizard_view_form" model="ir.ui.view">
        <field name="name">azk_dynamic_trial_balance.wizard.form</field>
        <field name="model">azk_dynamic_trial_balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Dynamic Trial Balance">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id"
                               domain="[('id', 'in', allowed_company_ids)]"
                               options="{'no_create': True, 'no_open': True}"
                               groups="base.group_multi_company"/>
                    </group>
                    <group string="Options">
                        <field name="posted_entries"/>
                        <field name="include_unposted"/>
                        <field name="hierarchy_subtotals"/>
                        <field name="hierarchy_only_parents"
                               invisible="not hierarchy_subtotals"/>
                        <field name="account_level"
                               invisible="not hierarchy_only_parents"
                               required="hierarchy_only_parents"/>
                        <field name="skip_zero_balance"/>
                        <field name="show_amount_currency"/>
                    </group>
                </group>
                <group string="Filters">
                    <field name="account_prefix_ids" widget="many2many_tags"
                           placeholder="Type a code prefix, for example 10"/>
                    <field name="journal_id" placeholder="All journals"
                           options="{'no_create': True}"/>
                    <field name="analytic_account_id" placeholder="All analytic accounts"
                           options="{'no_create': True}"
                           groups="analytic.group_analytic_accounting"/>
                </group>
                <footer>
                    <button name="action_preview" string="Preview" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_export_pdf" string="PDF" type="object"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" string="XLSX" type="object"
                            class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="trial_balance_wizard_action" model="ir.actions.act_window">
        <field name="name">Dynamic Trial Balance</field>
        <field name="res_model">azk_dynamic_trial_balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="trial_balance_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <!-- Accounting > Reporting > Audit Reports, next to the standard Trial Balance. -->
    <menuitem id="menu_dynamic_trial_balance"
              name="Dynamic Trial Balance"
              parent="account_reports.account_reports_audit_reports_menu"
              action="trial_balance_wizard_action"
              sequence="20"
              groups="account.group_account_readonly"/>
</odoo>
