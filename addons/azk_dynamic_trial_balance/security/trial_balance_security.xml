<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 18 has no built-in owner check for transient records: only access
        rights and record rules apply. These global rules keep each wizard and
        its prefixes private to the user who created them, so another user
        cannot read, run or export them by guessing an id.
    -->
    <record id="rule_trial_balance_wizard_owner" model="ir.rule">
        <field name="name">Dynamic Trial Balance wizard: own records only</field>
        <field name="model_id" ref="model_azk_dynamic_trial_balance_wizard"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_trial_balance_prefix_owner" model="ir.rule">
        <field name="name">Dynamic Trial Balance account prefix: own records only</field>
        <field name="model_id" ref="model_azk_dynamic_trial_balance_account_prefix"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
</odoo>
