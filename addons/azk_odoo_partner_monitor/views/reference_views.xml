<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="reference_view_list" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.reference.list</field>
        <field name="model">azk_odoo_partner_monitor.reference</field>
        <field name="arch" type="xml">
            <list string="References" create="0" edit="0" delete="0" decoration-muted="not is_active">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="is_active"/>
                <field name="added_on"/>
                <field name="removed_on"/>
                <field name="source_key" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="reference_view_form" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.reference.form</field>
        <field name="model">azk_odoo_partner_monitor.reference</field>
        <field name="arch" type="xml">
            <form string="Reference" create="0" edit="0" delete="0">
                <sheet>
                    <widget name="web_ribbon" title="Removed" bg_color="text-bg-secondary" invisible="is_active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source_key"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="added_on"/>
                            <field name="removed_on"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="reference_view_search" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.reference.search</field>
        <field name="model">azk_odoo_partner_monitor.reference</field>
        <field name="arch" type="xml">
            <search string="References">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="active_references" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="removed_references" string="Removed" domain="[('is_active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_added_month" string="Month Added" context="{'group_by': 'added_on:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="reference_action" model="ir.actions.act_window">
        <field name="name">References</field>
        <field name="res_model">azk_odoo_partner_monitor.reference</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="reference_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No references yet</p>
            <p>Client references appear after a sync reads the partners' detail pages.</p>
        </field>
    </record>

</odoo>
