<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="country_view_list" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.country.list</field>
        <field name="model">azk_odoo_partner_monitor.country</field>
        <field name="arch" type="xml">
            <list string="Countries" create="0" edit="0" delete="0" decoration-muted="not active"
                  decoration-danger="reprocess_exhausted">
                <field name="name"/>
                <field name="total_partner_count"/>
                <field name="snapshot_partner_count" optional="show"/>
                <field name="partner_count"/>
                <field name="validation_state" widget="badge" optional="show"
                       decoration-success="validation_state == 'matched'"
                       decoration-danger="validation_state == 'mismatch'"/>
                <field name="to_reprocess_partners" optional="show"/>
                <field name="reprocess_attempts" optional="hide"/>
                <field name="validated_at" optional="hide"/>
                <field name="reprocess_exhausted" column_invisible="True"/>
                <field name="is_demo" optional="show"/>
                <field name="source_key" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="country_view_form" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.country.form</field>
        <field name="model">azk_odoo_partner_monitor.country</field>
        <field name="arch" type="xml">
            <form string="Country" create="0" edit="0" delete="0">
                <header>
                    <button name="action_mark_for_rescrape" type="object" string="Mark for Re-scrape"
                            groups="azk_odoo_partner_monitor.group_manager"
                            invisible="to_reprocess_partners or not active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Demo" bg_color="text-bg-warning" invisible="not is_demo or not active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Website">
                            <field name="source_key"/>
                            <field name="total_partner_count"/>
                            <field name="to_reprocess_partners"/>
                        </group>
                        <group string="Database">
                            <field name="partner_count"/>
                            <field name="is_demo"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Validation" name="validation">
                            <field name="validation_state"/>
                            <field name="validated_at"/>
                            <field name="snapshot_partner_count"/>
                            <field name="previous_partner_count"/>
                        </group>
                        <group string="Re-scrape" name="rescrape">
                            <field name="reprocess_attempts"/>
                            <field name="next_reprocess_at"/>
                            <field name="reprocess_exhausted"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Partners" name="partners">
                            <field name="partner_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="current_status" widget="badge"
                                           decoration-warning="current_status == 'gold'"
                                           decoration-info="current_status == 'silver'"
                                           decoration-success="current_status == 'ready'"/>
                                    <field name="first_seen_on"/>
                                    <field name="last_seen_on"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="country_view_search" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.country.search</field>
        <field name="model">azk_odoo_partner_monitor.country</field>
        <field name="arch" type="xml">
            <search string="Countries">
                <field name="name"/>
                <field name="source_key"/>
                <filter name="needs_rescrape" string="Needs Re-scrape" domain="[('to_reprocess_partners', '=', True)]"/>
                <filter name="mismatch" string="Validation Mismatch" domain="[('validation_state', '=', 'mismatch')]"/>
                <filter name="exhausted" string="Retries Exhausted" domain="[('reprocess_exhausted', '=', True)]"/>
                <separator/>
                <filter name="website_data" string="Website Data" domain="[('is_demo', '=', False)]"/>
                <filter name="demo_data" string="Demo Data" domain="[('is_demo', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_needs_rescrape" string="Needs Re-scrape" context="{'group_by': 'to_reprocess_partners'}"/>
                    <filter name="group_validation" string="Validation" context="{'group_by': 'validation_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="country_action" model="ir.actions.act_window">
        <field name="name">Countries</field>
        <field name="res_model">azk_odoo_partner_monitor.country</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="country_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No countries yet</p>
            <p>Countries appear after a sync reads the country list of the Odoo Partners website.</p>
        </field>
    </record>

</odoo>
