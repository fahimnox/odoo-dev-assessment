<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sync runs: readers see runs and their chatter; work items, errors and
         counters are manager-only fields (groups on the Python fields). -->
    <record id="sync_run_view_list" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.sync.run.list</field>
        <field name="model">azk_odoo_partner_monitor.sync.run</field>
        <field name="arch" type="xml">
            <list string="Sync Runs" create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed'" decoration-warning="state == 'partial'">
                <header>
                    <button name="action_sync_now" type="object" string="Sync Now" class="btn-primary"
                            groups="azk_odoo_partner_monitor.group_manager" display="always"/>
                </header>
                <field name="display_name" string="Run"/>
                <field name="started_at"/>
                <field name="trigger"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'running'"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'failed'"/>
                <field name="finished_at" optional="show"/>
                <field name="waiting_reason" optional="show" decoration-warning="waiting_reason"/>
                <field name="pending_count" optional="show"/>
                <field name="done_count" optional="show"/>
                <field name="failed_count" optional="show"/>
                <field name="error_count" optional="show"/>
                <field name="notified_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sync_run_view_form" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.sync.run.form</field>
        <field name="model">azk_odoo_partner_monitor.sync.run</field>
        <field name="arch" type="xml">
            <form string="Sync Run" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="running,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not waiting_reason">
                        <strong>Waiting: </strong><field name="waiting_reason" class="d-inline"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="trigger"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="notified_at"/>
                        </group>
                        <group groups="azk_odoo_partner_monitor.group_manager">
                            <field name="pending_count"/>
                            <field name="done_count"/>
                            <field name="failed_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <notebook groups="azk_odoo_partner_monitor.group_manager">
                        <page string="Work Items" name="work_items">
                            <field name="work_item_ids">
                                <list decoration-danger="state == 'failed'">
                                    <field name="kind"/>
                                    <field name="country_id"/>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                    <field name="attempt_count"/>
                                    <field name="next_attempt_at"/>
                                    <field name="finished_at"/>
                                    <field name="result_summary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Errors" name="errors">
                            <field name="error_ids">
                                <list>
                                    <field name="occurred_at"/>
                                    <field name="error_class"/>
                                    <field name="message"/>
                                    <field name="url"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sync_run_view_search" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.sync.run.search</field>
        <field name="model">azk_odoo_partner_monitor.sync.run</field>
        <field name="arch" type="xml">
            <search string="Sync Runs">
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="waiting" string="Waiting" domain="[('waiting_reason', '!=', False)]"/>
                <filter name="problems" string="Partial or Failed" domain="[('state', 'in', ('partial', 'failed'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_trigger" string="Trigger" context="{'group_by': 'trigger'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sync_run_action" model="ir.actions.act_window">
        <field name="name">Sync Runs</field>
        <field name="res_model">azk_odoo_partner_monitor.sync.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sync_run_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No sync runs yet</p>
            <p>A run is created by the daily job or when a manager clicks Sync Now.</p>
        </field>
    </record>

    <!-- Work items (managers only) -->
    <record id="work_item_view_list" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.work.item.list</field>
        <field name="model">azk_odoo_partner_monitor.work.item</field>
        <field name="arch" type="xml">
            <list string="Work Items" create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed'" decoration-muted="state in ('done', 'cancelled')">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            groups="azk_odoo_partner_monitor.group_manager"/>
                </header>
                <field name="run_id"/>
                <field name="kind"/>
                <field name="country_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at"/>
                <field name="finished_at" optional="show"/>
                <field name="result_summary" optional="show"/>
                <field name="last_error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="work_item_view_form" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.work.item.form</field>
        <field name="model">azk_odoo_partner_monitor.work.item</field>
        <field name="arch" type="xml">
            <form string="Work Item" create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary"
                            groups="azk_odoo_partner_monitor.group_manager" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="run_id"/>
                            <field name="country_id" invisible="not country_id"/>
                            <field name="partner_id" invisible="not partner_id"/>
                        </group>
                        <group>
                            <field name="attempt_count"/>
                            <field name="next_attempt_at"/>
                            <field name="finished_at"/>
                            <field name="result_summary"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Errors" name="errors">
                            <field name="error_ids">
                                <list>
                                    <field name="occurred_at"/>
                                    <field name="error_class"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="work_item_view_search" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.work.item.search</field>
        <field name="model">azk_odoo_partner_monitor.work.item</field>
        <field name="arch" type="xml">
            <search string="Work Items">
                <field name="run_id"/>
                <field name="country_id"/>
                <field name="partner_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_run" string="Run" context="{'group_by': 'run_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="work_item_action" model="ir.actions.act_window">
        <field name="name">Work Items</field>
        <field name="res_model">azk_odoo_partner_monitor.work.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="work_item_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No work items</p>
            <p>A sync splits its work into small units: the country list, each country's partners, and each partner's details.</p>
        </field>
    </record>

    <!-- Errors (managers only) -->
    <record id="sync_error_view_list" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.sync.error.list</field>
        <field name="model">azk_odoo_partner_monitor.sync.error</field>
        <field name="arch" type="xml">
            <list string="Sync Errors" create="0" edit="0" delete="0">
                <field name="occurred_at"/>
                <field name="run_id"/>
                <field name="kind" optional="show"/>
                <field name="country_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="error_class"/>
                <field name="message"/>
                <field name="url" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sync_error_view_form" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.sync.error.form</field>
        <field name="model">azk_odoo_partner_monitor.sync.error</field>
        <field name="arch" type="xml">
            <form string="Sync Error" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="error_class"/>
                            <field name="occurred_at"/>
                            <field name="url" widget="url"/>
                        </group>
                        <group>
                            <field name="run_id"/>
                            <field name="work_item_id"/>
                            <field name="country_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Trace" invisible="not trace">
                        <field name="trace" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sync_error_view_search" model="ir.ui.view">
        <field name="name">azk_odoo_partner_monitor.sync.error.search</field>
        <field name="model">azk_odoo_partner_monitor.sync.error</field>
        <field name="arch" type="xml">
            <search string="Sync Errors">
                <field name="message"/>
                <field name="error_class"/>
                <field name="run_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_error_class" string="Error Type" context="{'group_by': 'error_class'}"/>
                    <filter name="group_run" string="Run" context="{'group_by': 'run_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sync_error_action" model="ir.actions.act_window">
        <field name="name">Sync Errors</field>
        <field name="res_model">azk_odoo_partner_monitor.sync.error</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sync_error_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sync errors</p>
            <p>Every failed unit of a sync is recorded here with its run, target and URL.</p>
        </field>
    </record>

</odoo>
