<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.azk_odoo_partner_monitor</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Partner Monitor" string="Partner Monitor" name="azk_odoo_partner_monitor"
                     groups="base.group_system">
                    <block title="Website Downloads" id="partner_monitor_downloads">
                        <setting id="partner_monitor_downloads_paused"
                                 help="While paused, the sync jobs keep their queue and download nothing from the Odoo website; open runs show that they are waiting.">
                            <field name="partner_monitor_downloads_paused"/>
                        </setting>
                    </block>
                    <block title="Failure Notifications" id="partner_monitor_notifications">
                        <setting id="partner_monitor_failure_recipient" string="Failure Recipient"
                                 help="Internal user who receives a note when a sync run fails or ends partially. Default: the administrator.">
                            <field name="partner_monitor_notify_user_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'azk_odoo_partner_monitor', 'bin_size': False}</field>
    </record>

</odoo>
