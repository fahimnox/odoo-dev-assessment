<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_partner_monitor" model="ir.module.category">
        <field name="name">Partner Monitor</field>
        <field name="description">Access to the data scraped from the Odoo Partners website.</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="category_id" ref="module_category_partner_monitor"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Reads countries, partners, status history, references and sync runs.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_partner_monitor"/>
        <field name="implied_ids" eval="[Command.link(ref('group_reader'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Also sees work items and errors, queues a sync, retries failed work and marks records for re-scraping.</field>
    </record>

</odoo>
