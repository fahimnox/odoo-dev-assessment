<?xml version="1.0" encoding="utf-8"?>
<!--
    SYNTHETIC DEMO DATA. Nothing here was scraped from the Odoo website.

    Every record is labeled: countries and partners have is_demo = True and
    names starting with "Demo"; demo countries use "demo-..." website IDs and
    demo partners use negative website IDs, which the database reserves for
    demo records, so a real scrape can never update or collide with them.
    Demo partners have no partner_url because they have no real page.

    The data is deterministic (fixed dates and values) and follows the same
    rules as scraped data; the model constraints check it at install time:
    one initial history row per partner, dated on first_seen_on, then one row
    per promotion or demotion; one active reference per key; removed
    references keep their dates, and a returning reference opens a new record.
-->
<odoo>

    <!-- Countries -->
    <record id="demo_country_alpha" model="azk_odoo_partner_monitor.country">
        <field name="name">Demo Country Alpha</field>
        <field name="source_key">demo-01</field>
        <field name="is_demo" eval="True"/>
        <field name="total_partner_count">3</field>
    </record>
    <record id="demo_country_beta" model="azk_odoo_partner_monitor.country">
        <field name="name">Demo Country Beta</field>
        <field name="source_key">demo-02</field>
