    <!-- Aurora: Silver, then promoted to Gold. A reference was removed and came back. -->
    <record id="demo_partner_aurora" model="azk_odoo_partner_monitor.partner">
        <field name="name">Demo Partner Aurora</field>
        <field name="source_id">-1001</field>
        <field name="is_demo" eval="True"/>
        <field name="country_id" ref="demo_country_alpha"/>
        <field name="current_status">gold</field>
        <field name="first_seen_on">2024-03-04</field>
        <field name="last_seen_on">2026-11-02</field>
        <field name="retention_rate">92.5</field>
        <field name="retention_rate_known" eval="True"/>
        <field name="total_references_count">2</field>
        <field name="total_references_count_known" eval="True"/>
        <field name="largest_project_size">120</field>
        <field name="largest_project_size_known" eval="True"/>
        <field name="average_project_size">18.4</field>
        <field name="average_project_size_known" eval="True"/>
