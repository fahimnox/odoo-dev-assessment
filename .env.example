# Local secrets for compose.yaml. Copy to .env and replace the values, or run
# "scripts/dev.sh setup", which creates .env with random passwords.
# .env is ignored by Git; never commit real passwords.

# PostgreSQL bootstrap superuser (used only inside the db container).
POSTGRES_PASSWORD=change-me
# Password of the "odoo" application role (not a superuser).
ODOO_DB_PASSWORD=change-me
# Host port for the Odoo web server, bound to 127.0.0.1 only.
ODOO_HTTP_PORT=8069

# Edition used by scripts/dev.sh: "community" or "enterprise".
ODOO_EDITION=community
# Enterprise only: folder that holds the Odoo 18 Enterprise addons (web_enterprise,
# account_reports, ...). The Enterprise source is proprietary: keep it outside this
# repository. A relative path is resolved from the repository root.
ENTERPRISE_ADDONS=
# Host port for the Enterprise web server, bound to 127.0.0.1 only.
ODOO_EE_HTTP_PORT=8070

# Edition "enterprise-20241208" (matched pair) only: folder of the official
# odoo/odoo source at commit 4e5027c159a9d9a8dd006618486c8e54cb1eb453 (it
# contains odoo/ and addons/). Its Enterprise addons are ENTERPRISE_ADDONS above.
COMMUNITY_SOURCE_20241208=
# Host port for the matched-pair web server, bound to 127.0.0.1 only.
ODOO_EE_20241208_HTTP_PORT=8071
